datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @db.VarChar(255)
  fullName      String    @db.VarChar(100)
  avatarUrl     String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @db.Timestamptz()

  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  ownedProjects     Project[]          @relation("ProjectOwner")
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")
  uploadedAssets    KnowledgeAsset[]   @relation("AssetUploader")
  dailyDockets      DailyFocusDocket[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.VarChar(255)
  revoked    Boolean  @default(false)
  expiresAt  DateTime @db.Timestamptz()
  createdAt  DateTime @default(now()) @db.Timestamptz()

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @db.VarChar(100)
  slug       String        @unique @db.VarChar(120)
  type       WorkspaceType @default(TEAM)
  ownerId    String        @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz()
  updatedAt  DateTime      @updatedAt @db.Timestamptz()

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  projects       Project[]
  knowledgeItems KnowledgeItem[]
  assets         KnowledgeAsset[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now()) @db.Timestamptz()

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum ProjectVisibility {
  PERSONAL
  TEAM
}

model Project {
  id                 String            @id @default(uuid()) @db.Uuid
  workspaceId        String            @db.Uuid
  ownerId            String            @db.Uuid
  originKnowledgeId  String?           @db.Uuid
  title              String            @db.VarChar(200)
  description        String?           @db.Text
  visibility         ProjectVisibility @default(PERSONAL)
  colorCode          String            @default("#3B82F6") @db.VarChar(7)
  isArchived         Boolean           @default(false)
  createdAt          DateTime          @default(now()) @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @db.Timestamptz()

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner              User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  originKnowledge    KnowledgeItem?    @relation("ProjectOriginKnowledge", fields: [originKnowledgeId], references: [id], onDelete: SetNull)
  tasks              Task[]
  assets             KnowledgeAsset[]
  knowledgeItems     KnowledgeItem[]
  quizzes            Quiz[]

  @@index([workspaceId, visibility])
  @@index([ownerId])
  @@map("projects")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  creatorId   String        @db.Uuid
  assigneeId  String?       @db.Uuid
  title       String        @db.VarChar(255)
  description String?       @db.Text
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  weight      Int           @default(1)    // 1=Micro (15m), 3=Standard, 5=Milestone
  orderIndex  Float         @default(0.0)  // Fractional index for drag-and-drop
  dueDate     DateTime?     @db.Timestamptz()
  createdAt   DateTime      @default(now()) @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @db.Timestamptz()

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User               @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklists  TaskChecklist[]
  dockets     DailyFocusDocket[]

  @@index([projectId, status, orderIndex])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskChecklist {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  title       String   @db.VarChar(255)
  isCompleted Boolean  @default(false)
  orderIndex  Int      @default(0)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

enum DocketTier {
  PRIMARY
  MOMENTUM
}

model DailyFocusDocket {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  taskId      String     @db.Uuid
  targetDate  DateTime   @db.Date
  tier        DocketTier @default(MOMENTUM)
  isCompleted Boolean    @default(false)
  completedAt DateTime?  @db.Timestamptz()

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, targetDate])
  @@index([userId, targetDate])
  @@map("daily_focus_dockets")
}

enum AssetType {
  LINK
  SCREENSHOT
  NOTE
  DOCUMENT
}

enum AssetBucket {
  LINKS
  SCREENSHOTS
  ARTICLES
  SNIPPETS
  GENERAL
}

model KnowledgeItem {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @db.Uuid
  projectId         String?          @db.Uuid
  title             String           @db.VarChar(200)
  technology        String           @db.VarChar(50)   // e.g., "React", "pgvector"
  category          String           @db.VarChar(50)   // e.g., "Frontend", "AI/ML"
  difficulty        String           @default("INTERMEDIATE")
  summary           String           @db.Text
  keyPoints         Json             @default("[]")
  codeExamples      Json             @default("[]")
  tags              String[]         @default([])
  confidence        Float            @default(1.0)
  createdAt         DateTime         @default(now()) @db.Timestamptz()
  updatedAt         DateTime         @updatedAt @db.Timestamptz()

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sources           KnowledgeAsset[]
  quizzes           Quiz[]
  generatedProjects Project[]        @relation("ProjectOriginKnowledge")

  @@index([workspaceId, category])
  @@index([workspaceId, technology])
  @@map("knowledge_items")
}

model KnowledgeAsset {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  projectId       String?        @db.Uuid
  creatorId       String         @db.Uuid
  knowledgeItemId String?        @db.Uuid

  type            AssetType
  bucket          AssetBucket    @default(GENERAL)
  title           String         @db.VarChar(255)
  sourceUrl       String?        @db.Text
  storagePath     String?        @db.Text
  thumbnailUrl    String?        @db.Text
  authorName      String?        @db.VarChar(100)
  rawContent      String?        @db.Text
  aiSummary       String?        @db.Text
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @db.Timestamptz()

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator         User           @relation("AssetUploader", fields: [creatorId], references: [id], onDelete: Cascade)
  knowledgeItem   KnowledgeItem? @relation(fields: [knowledgeItemId], references: [id], onDelete: SetNull)

  @@index([workspaceId, bucket])
  @@index([knowledgeItemId])
  @@map("knowledge_assets")
}

model Quiz {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String?         @db.Uuid
  knowledgeItemId    String?         @db.Uuid
  question           String          @db.Text
  options            Json
  correctAnswerIndex Int             @db.SmallInt
  explanation        String          @db.Text
  dueDate            DateTime        @db.Date
  intervalDays       Int             @default(1)
  repetitionCount    Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamptz()

  project            Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  knowledgeItem      KnowledgeItem?  @relation(fields: [knowledgeItemId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@map("quizzes")
}